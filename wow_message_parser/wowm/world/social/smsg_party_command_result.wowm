enum PartyResult : u8 {
    SUCCESS = 0;
    BAD_PLAYER_NAME = 1;
    TARGET_NOT_IN_GROUP = 2;
    GROUP_FULL = 3;
    ALREADY_IN_GROUP = 4;
    NOT_IN_GROUP = 5;
    NOT_LEADER = 6;
    PLAYER_WRONG_FACTION = 7;
    IGNORING_YOU = 8;
} {
    versions = "1.12";
}

enum PartyResult : u8 {
    SUCCESS = 0;
    BAD_PLAYER_NAME = 1;
    TARGET_NOT_IN_GROUP = 2;
    TARGET_NOT_IN_INSTANCE = 3;
    GROUP_FULL = 4;
    ALREADY_IN_GROUP = 5;
    NOT_IN_GROUP = 6;
    NOT_LEADER = 7;
    PLAYER_WRONG_FACTION = 8;
    IGNORING_YOU = 9;
    LFG_PENDING = 12;
    INVITE_RESTRICTED = 13;
} {
    versions = "2.4.3 3";
}

enum PartyOperation : u8 {
    INVITE = 0;
    LEAVE = 2;
} {
    versions = "1 2 3";
}

smsg SMSG_PARTY_COMMAND_RESULT = 0x007F {
    (u32)PartyOperation operation;
    CString member {
        maximum_length = "48";
    }
    (u32)PartyResult result;
} {
    paste_versions = "1.12";
}

smsg SMSG_PARTY_COMMAND_RESULT = 0x007F {
    (u32)PartyOperation operation;
    CString member {
        maximum_length = "48";
    }
    (u32)PartyResult result;
} {
    paste_versions = "2.4.3";
}

smsg SMSG_PARTY_COMMAND_RESULT = 0x007F {
    /// TrinityCore's `PartyOperation`, which has an uninvite (1) and a swap (4) as well.
    u32 operation;
    CString member {
        maximum_length = "48";
    }
    /// TrinityCore's `PartyResult`, which goes on past 13.
    u32 result;
    /// TrinityCore: "LFD cooldown related".
    u32 lfd_cooldown;
} {
    versions = "3.3.5";
}

test SMSG_PARTY_COMMAND_RESULT {
    operation = 0;
    member = "Thrall";
    result = 0;
    lfd_cooldown = 0;
} [
    0x00, 0x15, /* size */
    0x7F, 0x00, /* opcode */
    0x00, 0x00, 0x00, 0x00, /* operation */
    0x54, 0x68, 0x72, 0x61, 0x6C, 0x6C, 0x00, /* member */
    0x00, 0x00, 0x00, 0x00, /* result */
    0x00, 0x00, 0x00, 0x00, /* lfd_cooldown */
] {
    versions = "3.3.5";
}

