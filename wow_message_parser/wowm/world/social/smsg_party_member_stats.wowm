smsg SMSG_PARTY_MEMBER_STATS = 0x007E {
    PackedGuid guid;
    GroupUpdateFlags mask;
    if (mask & STATUS) {
        /// `GroupMemberOnlineStatus` bits, written as a u16. TrinityCore: `uint16(playerStatus)`.
        u16 status;
    }
    if (mask & CUR_HP) {
        u32 current_health;
    }
    if (mask & MAX_HP) {
        u32 max_health;
    }
    if (mask & POWER_TYPE) {
        Power power; 
    }
    if (mask & CUR_POWER) {
        u16 current_power;
    }
    if (mask & MAX_POWER) {
        u16 max_power;
    }
    if (mask & LEVEL) {
        Level16 level;
    }
    if (mask & ZONE) {
        /// TrinityCore: `uint16(GetZoneId())`.
        u16 zone;
    }
    if (mask & POSITION) {
        /// cmangos: float cast to u16
        u16 position_x;
        /// cmangos: float cast to u16
        u16 position_y;
    }
    if (mask & AURAS) {
        /// cmangos: In all checked pre-2.x data of packets included only positive auras
        AuraMask auras;
    }
    if (mask & PET_GUID) {
        Guid pet;
    }
    if (mask & PET_NAME) {
        CString pet_name;
    }
    if (mask & PET_MODEL_ID) {
        u16 pet_display_id;
    }
    if (mask & PET_CUR_HP) {
        u32 pet_current_health;
    }
    if (mask & PET_MAX_HP) {
        u32 pet_max_health;
    }
    if (mask & PET_POWER_TYPE) {
        Power pet_power_type;
    }
    if (mask & PET_CUR_POWER) {
        u16 pet_current_power;
    }
    if (mask & PET_MAX_POWER) {
        u16 pet_max_power;
    }
    if (mask & PET_AURAS) {
        AuraMask pet_auras;
    }
    if (mask & VEHICLE_SEAT) {
        u32 transport;
    }
} {
    versions = "3.3.5";
}

struct Aura {
    u32 aura;
    u8 unknown;
} {
    versions = "3.3.5";
    rust_base_type = "true";
}

test SMSG_PARTY_MEMBER_STATS {
    guid = 6;
    mask = STATUS | CUR_HP | MAX_HP | LEVEL | ZONE;
    status = 5;
    current_health = 120;
    max_health = 400;
    level = 12;
    zone = 12;
} [
    0x00, 0x16, /* size */
    0x7E, 0x00, /* opcode */
    0x01, 0x06, /* guid */
    0xC7, 0x00, 0x00, 0x00, /* mask */
    0x05, 0x00, /* status: online and dead */
    0x78, 0x00, 0x00, 0x00, /* current_health */
    0x90, 0x01, 0x00, 0x00, /* max_health */
    0x0C, 0x00, /* level */
    0x0C, 0x00, /* zone */
] {
    versions = "3.3.5";
}
